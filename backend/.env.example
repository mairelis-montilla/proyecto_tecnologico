# =============================================
# BACKEND - Variables de Entorno
# Copia este archivo como .env y completa los valores
# =============================================

# ---- SERVIDOR ----
# Desarrollo: development | Producción: production
NODE_ENV=development
# Render asigna PORT automáticamente en producción, no lo cambies
PORT=4000

# ---- BASE DE DATOS ----
# Desarrollo: mongodb://localhost:27017/mentordb
# Producción: URI de MongoDB Atlas
MONGODB_URI=mongodb://localhost:27017/mentordb

# ---- JWT ----
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# ---- CORS ----
# Desarrollo: http://localhost:3000
# Producción: URL de tu app en Netlify (ej: https://mentormatch.netlify.app)
CORS_ORIGIN=http://localhost:3000

# ---- APP ----
APP_NAME=MentorMatch

# ---- CLOUDINARY (para subir imágenes) ----
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ---- EMAIL ----
# OPCIÓN 1 (PRODUCCIÓN): Resend API - no usa SMTP, funciona en cualquier cloud
# Regístrate gratis en https://resend.com → Crear API Key → pegar aquí
# Sin dominio verificado usa "onboarding@resend.dev" como remitente de prueba
# Con dominio verificado: RESEND_FROM=MentorMatch <noreply@tudominio.com>
RESEND_API_KEY=re_WxM2HEXb_4fJcyYUiK7ogQbaYkv6bq35u
RESEND_FROM=MentorMatch <noreply@tudominio.com>

# OPCIÓN 2 (DESARROLLO LOCAL): Gmail SMTP con App Password
# Nota: Gmail SMTP puede estar bloqueado en servidores cloud (Render/Railway)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tucorreo@gmail.com
SMTP_PASS=tu_app_password_de_gmail
SMTP_FROM=MentorMatch <tucorreo@gmail.com>
